<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BizertIA | Internship Submission</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #F1F5F9;
        }

        ::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 4px;
        }

        .fade-in {
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body class="bg-sky-50 text-slate-800 min-h-screen">

<!-- NAVBAR -->
<nav class="bg-white border-b border-slate-200 sticky top-0 z-[100] shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
            <div class="flex items-center space-x-8">
                <a href="/" class="flex-shrink-0 flex items-center gap-3 text-xl font-bold text-slate-800">
                    <img src="/logo BizertIA.png" alt="BizertIA Logo" class="h-9 w-auto rounded-md">
                    <span>BizertIA</span>
                </a>
                <div class="hidden md:flex space-x-2">
                    <a href="/" class="text-slate-700 bg-slate-100 px-3 py-2 rounded-md text-sm font-medium border border-slate-200 transition hover:bg-slate-200">Home</a>
                    <a href="/about" class="text-slate-600 hover:text-sky-700 hover:bg-slate-100 px-3 py-2 rounded-md text-sm font-medium transition">
                        About BizertIA
                    </a>
                </div>
            </div>

            <div class="flex items-center gap-4 relative">
                <div class="hidden sm:flex flex-col items-end">
                    <span class="text-sm font-semibold text-slate-800">
                        <%= user.lastName %> <%= user.firstName %>
                    </span>
                    <span class="text-xs text-sky-600">
                        ID: <%= user.nationalId ? user.nationalId : 'N/A' %>
                    </span>
                </div>

                <div class="relative">
                    <button id="user-menu-button" class="flex items-center gap-2 focus:outline-none group">
                        <img class="h-10 w-10 rounded-full object-cover border-2 border-slate-200 group-hover:border-sky-400 transition shadow-sm"
                             src="<%= user.profilePicture ? user.profilePicture : '/uploads/default-avatars/default-avatar.png' %>"
                             alt="Profile">
                    </button>
                </div>
            </div>
        </div>
    </div>
</nav>

<!-- PAGE -->
<main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <div class="mb-10">
        <h1 class="text-4xl font-bold text-slate-800">Internship Submission</h1>
        <p class="text-slate-600 mt-3 text-lg">
            Upload your internship completion document in PDF format. Our AI assistant will scan and analyze the document automatically.
        </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 mb-12">
        <div class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm">
            <div class="flex items-center gap-3 mb-6">
                <div class="bg-sky-100 text-sky-600 p-3 rounded-xl"><i class="fa-solid fa-file-pdf text-2xl"></i></div>
                <div>
                    <h2 class="text-2xl font-bold text-slate-800">Upload PDF</h2>
                    <p class="text-sm text-slate-500">Internship certificate or report</p>
                </div>
            </div>
            <form id="internship-form" enctype="multipart/form-data" class="space-y-6">
                <label for="pdfFile" class="border-2 border-dashed border-slate-300 hover:border-sky-400 transition-all rounded-2xl p-10 flex flex-col items-center justify-center text-center cursor-pointer bg-slate-50">
                    <div class="bg-slate-100 p-5 rounded-full mb-4"><i class="fa-solid fa-cloud-arrow-up text-4xl text-sky-500"></i></div>
                    <h3 class="text-lg font-semibold text-slate-800">Click to upload your PDF</h3>
                    <p class="text-sm text-slate-500 mt-2">Only PDF files are accepted</p>
                    <input type="file" id="pdfFile" name="pdfFile" accept="application/pdf" class="hidden" required>
                </label>
                <div id="file-info" class="hidden bg-slate-100 border border-slate-200 rounded-xl p-4 fade-in">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-file-pdf text-rose-500 text-2xl"></i>
                        <div class="flex-1 overflow-hidden">
                            <p id="file-name" class="text-slate-800 font-medium truncate"></p>
                            <p id="file-size" class="text-sm text-slate-500"></p>
                        </div>
                    </div>
                </div>
              
                <button type="submit" id="submit-btn" class="w-full bg-sky-600 hover:bg-sky-700 transition-all text-white font-semibold py-4 rounded-xl shadow-sm flex items-center justify-center gap-3 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                    <i class="fa-solid fa-paper-plane"></i> Submit Internship Document
                </button>
            </form>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm flex flex-col overflow-hidden">
            <div class="border-b border-slate-200 p-6 flex items-center gap-4">
                <div class="bg-emerald-100 text-emerald-600 p-3 rounded-xl"><i class="fa-solid fa-robot text-2xl"></i></div>
                <div>
                    <h2 class="text-2xl font-bold text-slate-800">AI Analysis</h2>
                    <p class="text-sm text-slate-500">Automated internship validation assistant</p>
                </div>
            </div>
            <div id="analysis-box" class="flex-1 p-6 overflow-y-auto bg-slate-50 min-h-[450px]">
                <div class="h-full flex items-center justify-center text-center text-slate-500">
                    <div>
                        <i class="fa-solid fa-brain text-5xl mb-5 text-slate-300"></i>
                        <p class="text-lg">AI analysis will appear here after submission</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6">
        <h2 class="text-2xl font-bold text-slate-800 mb-4"><i class="fa-solid fa-clock-history text-sky-500 mr-2"></i> Your Validated Internships</h2>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Enterprise</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Project</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Duration</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Date Verified</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Document</th>
                    </tr>
                </thead>
                <tbody id="internship-history-table" class="divide-y divide-slate-200 bg-white">
                    <% if (pastInternships && pastInternships.length > 0) { %>
                        <% pastInternships.forEach(intern => { %>
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap font-medium text-slate-800"><%= intern.enterpriseName %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= intern.project || 'N/A' %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= intern.durationMonths %> Months</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500"><%= new Date(intern.submittedAt).toLocaleDateString() %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <a href="<%= intern.documentUrl %>" target="_blank" class="text-sky-600 hover:text-sky-700 flex items-center gap-1">
                                        <i class="fa-solid fa-file-arrow-down"></i> View Certificate
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr id="empty-history-row">
                            <td colspan="5" class="px-6 py-10 text-center text-sm text-slate-500">No validated records discovered yet.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</main>

<script>
    const pdfInput  = document.getElementById('pdfFile');
    const fileInfo  = document.getElementById('file-info');
    const fileName  = document.getElementById('file-name');
    const fileSize  = document.getElementById('file-size');
    const form      = document.getElementById('internship-form');
    const analysisBox = document.getElementById('analysis-box');
    const submitBtn = document.getElementById('submit-btn');
    

    // =========================
    // FILE DISPLAY
    // =========================
    pdfInput.addEventListener('change', () => {
        const file = pdfInput.files[0];
        
        if (!file) {
            submitBtn.disabled = true;
            fileInfo.classList.add('hidden');
            return;
        }
        
        submitBtn.disabled = false;
        fileInfo.classList.remove('hidden');
        fileName.textContent = file.name;
        fileSize.textContent = (file.size / (1024 * 1024)).toFixed(2) + ' MB';
    });

    // =========================
    // FORM SUBMIT
    // =========================
    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const file = pdfInput.files[0];
        if (!file) return;

        const formData = new FormData();
        formData.append('pdfFile', file);

        // LOADING STATE
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
            <i class="fa-solid fa-spinner fa-spin"></i>
            Processing Internship Document...
        `;

        analysisBox.innerHTML = `
            <div class="flex flex-col items-center justify-center h-full text-center text-slate-700">
                <i class="fa-solid fa-spinner fa-spin text-5xl text-sky-500 mb-6"></i>
                <h3 class="text-2xl font-bold text-slate-800 mb-3">
                    I'am analyzing your document
                </h3>
                <p class="text-slate-600 max-w-md">
                    Extracting internship information, validating signatures,
                    and checking document completeness...
                </p>
            </div>
        `;

        try {
            const response = await fetch('/api/internships/analyze', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (data.success) {
               analysisBox.innerHTML = `
                <div class="fade-in flex flex-col items-center justify-center h-full text-center">
                    <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-10 w-full">
                        <i class="fa-solid fa-circle-check text-emerald-500 text-6xl mb-5"></i>
                        <h3 class="text-2xl font-bold text-slate-800 mb-3">Submission Successful</h3>
                        <p class="text-slate-600 text-base">
                            ${data.statusMessage || 'Your internship document has been recorded successfully.'}
                        </p>
                        <p class="text-sky-500 text-xs mt-4">Refreshing history list...</p>
                    </div>
                </div>
            `;
    
            setTimeout(() => {
                window.location.reload();
            }, 2000);
            
            } else {
                analysisBox.innerHTML = `
                    <div class="fade-in flex flex-col items-center justify-center h-full text-center">
                        <div class="bg-rose-50 border border-rose-200 rounded-2xl p-10 w-full">
                            <i class="fa-solid fa-circle-xmark text-rose-500 text-6xl mb-5"></i>
                            <h3 class="text-2xl font-bold text-slate-800 mb-3">Submission Failed</h3>
                            <p class="text-slate-600 text-base">
                                ${data.aiResponse || 'Your document could not be validated. Please check and try again.'}
                            </p>
                        </div>
                    </div>
                `;
            }

        } catch (err) {
            console.error(err);

            analysisBox.innerHTML = `
                <div class="fade-in flex flex-col items-center justify-center h-full text-center">
                    <div class="bg-rose-50 border border-rose-200 rounded-2xl p-10 w-full">
                        <i class="fa-solid fa-triangle-exclamation text-rose-500 text-6xl mb-5"></i>
                        <h3 class="text-2xl font-bold text-slate-800 mb-3">Upload Failed</h3>
                        <p class="text-slate-600 text-base">
                            Something went wrong while processing the internship document.
                            Please try again later.
                        </p>
                    </div>
                </div>
            `;

        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = `
                <i class="fa-solid fa-paper-plane"></i>
                Submit Internship Document
            `;
        }
    });
</script>

</body>
</html>