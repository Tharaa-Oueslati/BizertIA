<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BizertIA | About</title>
    <link rel="icon" type="image/png" href="/logo BizertIA.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/public/style/style.css">
    <style>
        /* Light & professional scrollbar - matching main.ejs */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #F1F5F9; border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #94A3B8; }

        /* Keep original chat animation but adapt to light theme (no background overrides) */
        .chat-window {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            transform: translateY(20px) scale(0.95);
            opacity: 0;
            pointer-events: none;
        }
        .chat-window.active {
            transform: translateY(0) scale(1);
            opacity: 1;
            pointer-events: auto;
        }

        /* Smooth card hover effect (light) */
        .feature-card {
            transition: all 0.3s ease;
        }
        .feature-card:hover {
            transform: translateY(-5px);
            border-color: #38BDF8;
            box-shadow: 0 20px 25px -12px rgba(0, 0, 0, 0.08);
        }
        
        /* Team social link transition */
        .social-icon {
            transition: all 0.2s ease;
        }
    </style>
</head>
<body class="bg-sky-50 min-h-screen font-sans flex flex-col text-slate-800">

<!-- Navbar - Light professional, identical style to main.ejs -->
<nav class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
            <div class="flex items-center space-x-8">
                <a href="/" class="flex-shrink-0 flex items-center gap-3 text-xl font-bold text-slate-800">
                    <img src="/logo BizertIA.png" alt="BizertIA Logo" class="h-9 w-auto rounded-md">
                    <span>BizertIA</span>
                </a>
                <div class="hidden md:flex space-x-2">
                    <a href="/" class="text-slate-600 hover:text-sky-700 hover:bg-slate-100 px-3 py-2 rounded-md text-sm font-medium transition">
                        Home
                    </a>
                    <a href="/about" class="text-slate-800 bg-slate-100 border border-slate-200 px-3 py-2 rounded-md text-sm font-medium transition">
                        About BizertIA
                    </a>
                </div>
            </div>
            
            <!-- User Section with Dropdown (light theme) -->
            <div class="flex items-center gap-4 relative">
                <div class="hidden sm:flex flex-col items-end">
                    <span class="text-sm font-semibold text-slate-800">
                        <%= user ? user.lastName + ' ' + user.firstName : 'Student' %>
                    </span>
                    <span class="text-xs text-sky-600">
                        ID: <%= user && user.nationalId ? user.nationalId : 'N/A' %>
                    </span>
                </div>

                <!-- Profile Picture with Dropdown -->
                <div class="relative">
                    <button id="user-menu-button" 
                            class="flex items-center gap-2 focus:outline-none group">
                        <img class="h-10 w-10 rounded-full object-cover border-2 border-slate-200 group-hover:border-sky-400 transition shadow-sm"
                             src="<%= user && user.profilePicture ? user.profilePicture : '/uploads/default-avatars/default-avatar.png' %>"
                             alt="Profile">
                        <i class="fa-solid fa-chevron-down text-slate-500 text-sm group-hover:text-slate-700 transition hidden md:block"></i>
                    </button>

                    <!-- Dropdown Menu - Light -->
                    <div id="user-dropdown" 
                         class="hidden absolute right-0 top-14 w-56 bg-white border border-slate-200 rounded-xl shadow-lg overflow-hidden z-50">
                        <div class="px-4 py-3 bg-slate-50 border-b border-slate-100">
                            <p class="text-xs text-slate-500">Signed in as</p>
                            <p class="text-sm font-medium text-slate-800 truncate">
                                <%= user ? user.email : 'student@bizertia.com' %>
                            </p>
                        </div>
                        <div class="py-2">
                            <a href="/profile" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-sky-50 hover:text-sky-700 transition">
                                <i class="fa-solid fa-user w-5 text-center"></i>
                                My Profile
                            </a>
                            <div class="border-t border-slate-100 my-2"></div>
                            <a href="/logout" class="flex items-center gap-3 px-4 py-2 text-sm text-rose-600 hover:bg-rose-50 hover:text-rose-700 transition">
                                <i class="fa-solid fa-right-from-bracket w-5 text-center"></i>
                                Sign Out
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</nav>

<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">

    <!-- Hero Section - Light & Airy with Logo above heading -->
    <section class="text-center py-12">
        <!-- Logo image placed prominently above the welcome text -->
        <div class="flex justify-center mb-8">
<img src="/logo BizertIA.png" alt="BizertIA Logo" class="w-32 h-32 md:w-40 md:h-40 object-cover rounded-full shadow-md bg-white p-2 border border-slate-200">        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-slate-800 mb-4">
            Welcome to <span class="text-sky-600">BizertIA</span>
        </h1>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto">
            Your modern digital companion for university life at the Faculty of Sciences of Bizerte
        </p>
    </section>

    <!-- Mission & Vision Cards - White, soft shadows, light borders -->
    <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300">
            <div class="w-16 h-16 bg-sky-100 rounded-xl flex items-center justify-center mb-6">
                <i class="fa-solid fa-rocket text-3xl text-sky-600"></i>
            </div>
            <h2 class="text-2xl font-bold text-slate-800 mb-4">Our Mission</h2>
            <p class="text-slate-600 leading-relaxed">
                To simplify student life by centralizing access to academic documents, attendance tracking, 
                requests for certificates, and communication with the administration — all in one secure, 
                fast and beautiful platform.
            </p>
        </div>

        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300">
            <div class="w-16 h-16 bg-indigo-100 rounded-xl flex items-center justify-center mb-6">
                <i class="fa-solid fa-eye text-3xl text-indigo-500"></i>
            </div>
            <h2 class="text-2xl font-bold text-slate-800 mb-4">Our Vision</h2>
            <p class="text-slate-600 leading-relaxed">
                Become the reference digital portal for Tunisian university students — intuitive, reliable, 
                and constantly evolving with the real needs of students and administrative staff.
            </p>
        </div>
    </div>

    <!-- Features Grid - Clean cards with subtle hover -->
    <section>
        <h3 class="text-2xl font-bold text-center text-slate-800 mb-10">What You Can Do on BizertIA </h3>
        <div class="grid md:grid-cols-3 gap-6">
            <div class="feature-card bg-white rounded-xl p-6 border border-slate-200 hover:border-sky-300 transition-all">
                <div class="w-14 h-14 bg-sky-100 rounded-lg flex items-center justify-center mb-4 group-hover:bg-sky-200 transition">
                    <i class="fa-solid fa-file-certificate text-2xl text-sky-600"></i>
                </div>
                <h4 class="text-lg font-semibold text-slate-800 mb-2">Certificates & Attestations</h4>
                <p class="text-slate-500 text-sm">Request and download official documents instantly</p>
            </div>

            <div class="feature-card bg-white rounded-xl p-6 border border-slate-200 hover:border-emerald-300 transition-all">
                <div class="w-14 h-14 bg-emerald-100 rounded-lg flex items-center justify-center mb-4">
                    <i class="fa-solid fa-clipboard-check text-2xl text-emerald-600"></i>
                </div>
                <h4 class="text-lg font-semibold text-slate-800 mb-2">Attendance Tracking</h4>
                <p class="text-slate-500 text-sm">Follow your presence and justifications in real time</p>
            </div>

            <div class="feature-card bg-white rounded-xl p-6 border border-slate-200 hover:border-indigo-300 transition-all">
                <div class="w-14 h-14 bg-indigo-100 rounded-lg flex items-center justify-center mb-4">
                    <i class="fa-solid fa-robot text-2xl text-indigo-500"></i>
                </div>
                <h4 class="text-lg font-semibold text-slate-800 mb-2">AI Assistant</h4>
                <p class="text-slate-500 text-sm">Get instant help 24/7 for all your questions</p>
            </div>
        </div>
    </section>

    <!-- Team / Credits - Light card with soft gradient background -->
    <section class="bg-white rounded-2xl p-8 border border-slate-200 text-center shadow-sm">
        <h3 class="text-2xl font-bold text-slate-800 mb-6">Made with passion</h3>
        <p class="text-slate-600 max-w-2xl mx-auto mb-8">
            BizertIA is a student project developed with love for better university life.
            Built with Node.js, Express, MongoDB, Tailwind CSS and a lot of coffee.
        </p>
        <div class="flex justify-center gap-6 text-2xl text-slate-400">
            <a href="#" class="social-icon hover:text-sky-600 transition"><i class="fab fa-github"></i></a>
            <a href="#" class="social-icon hover:text-sky-600 transition"><i class="fab fa-linkedin"></i></a>
            <a href="#" class="social-icon hover:text-sky-600 transition"><i class="fas fa-envelope"></i></a>
        </div>
    </section>

</main>

<!-- Scripts: Keep all original logic (chat toggle, dropdown, etc) unchanged -->
<script>
    // Chat toggle logic (same as original, references #ai-chat-window and #toggle-chat)
    // These elements may be defined globally or in a layout, but we keep the code intact.
    const chatWindow = document.getElementById('ai-chat-window');
    const toggleBtn  = document.getElementById('toggle-chat');
    const closeBtn   = document.getElementById('close-chat');
    const notificationPing = toggleBtn?.querySelector('.absolute.top-0');

    function toggleChat() {
        if (chatWindow) {
            chatWindow.classList.toggle('active');
        }
        // Hide notification dot forever after first open
        if (notificationPing) notificationPing.style.display = 'none';
    }

    if (toggleBtn) toggleBtn.addEventListener('click', toggleChat);
    if (closeBtn)  closeBtn.addEventListener('click', toggleChat);

    // Optional: close when clicking outside (nice UX)
    if (chatWindow && toggleBtn) {
        document.addEventListener('click', function(e) {
            if (!chatWindow.contains(e.target) && !toggleBtn.contains(e.target)) {
                chatWindow.classList.remove('active');
            }
        });
    }

    // Dropdown Logic (same as original)
    document.addEventListener('DOMContentLoaded', () => {
        const button = document.getElementById('user-menu-button');
        const dropdown = document.getElementById('user-dropdown');

        if (button && dropdown) {
            button.addEventListener('click', (e) => {
                e.stopPropagation();
                dropdown.classList.toggle('hidden');
            });

            document.addEventListener('click', (e) => {
                if (!button.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.classList.add('hidden');
                }
            });
        }
    });
</script>

<!-- Optional FontAwesome (if not already in layout, keep as is) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</body>
</html>